bootdelay=3
bootretry=30
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

# Fastboot is keen to use the address from kconfig, but we
# allocate its buffer at runtime.
fastboot=echo fastboot buffer located at 0x$fastboot_addr_r; fastboot -l $fastboot_addr_r usb 0

# Android boot images ignore their own load addresses, keep the kernel
# and ramdisk below the aee/pstore carveout at 0x48080000.
kernel_addr_r=0x40200000
ramdisk_addr_r=0x46000000

# bootm reads the header from the abootimg address, not the buffer
fastboot_bootcmd=abootimg addr ${fastboot_addr_r}; bootm ${fastboot_addr_r}

# For kernels compressed with gzip
kernel_comp_addr_r=0x52000000
kernel_comp_size=0x10000000
bootargs=clk_ignore_unused console=ttyS0,921600

# scsi scan is done by our misc_init.

# The default system is an Android boot image (kernel, initramfs, dtb,
# cmdline with root=) in the otherwise unused vendor_boot_b of the UFS
# user LU. The stock LK only looks at the partitions of the active slot.
boot_part=vendor_boot_b
normal_boot=echo "Booting ${boot_part}...";                           \
            scsi dev 2 &&                                            \
            part start scsi 2 ${boot_part} boot_part_start &&         \
            part size scsi 2 ${boot_part} boot_part_size &&           \
            scsi read ${fastboot_addr_r} ${boot_part_start} ${boot_part_size} && \
            abootimg addr ${fastboot_addr_r} &&                       \
            bootm ${fastboot_addr_r};                                \
            echo "Failed to boot ${boot_part}"

# Boot the system, fall back to fastboot if that fails
bootcmd=run normal_boot; run fastboot

# When entering the menu (either from button press or failed boot)
# remap bootcmd so it will re-open the menu and we won't get stuck
# at the console with no way to type
menucmd=setenv bootcmd run menucmd; bootmenu -1

# Pause is used so the output can be read on the display
bootmenu_0=Boot system=run normal_boot; pause
bootmenu_1=Enable serial console gadget=run serial_gadget
bootmenu_2=Enable USB mass storage=echo "Press any key to exit UMS mode"; ums 0 scsi 0
bootmenu_3=Enable fastboot mode=run fastboot
# Disabling bootretry means we'll just drop the shell
bootmenu_4=Drop to shell=setenv bootretry -1
bootmenu_5=Reset device=reset
bootmenu_6=Dump clocks=clk dump; pause
bootmenu_7=Dump environment=printenv; pause
bootmenu_8=Board info=bdinfo; pause
bootmenu_9=Dump bootargs=fdt print /chosen bootargs; pause

# Allow holding the volume up button while U-Boot loads to enter
# the boot menu
button_cmd_0_name=Volume Up
button_cmd_0=run menucmd
